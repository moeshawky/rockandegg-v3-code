{
  "name": "fullbb_bf16_e2style",
  "_comment": "Selected full-backbone configuration. Reproduces the BF16 E2-style recipe that produced the seed-0 checkpoint; set 'model' to the F32 v3 checkpoint (the published root weights, NOT the frozen-head release) or a local copy.",
  "model": "moeshawky/RockAndEgg-313M-v3",
  "device": "cuda:0",
  "split": "train",
  "seed": 0,
  "split_seed": 0,
  "val_fraction": 0.15,
  "epochs": 8,
  "micro_batch_size": 64,
  "grad_accum": 1,
  "eval_batch_size": 64,
  "lr_backbone": 2.5e-05,
  "lr_head": 0.0001,
  "weight_decay": 0.01,
  "warmup_frac": 0.03,
  "precision": "bf16",
  "bf16": true,
  "weights_dtype": "fp32",
  "emd_weight": 0.0,
  "option_permutation_aug": true,
  "perm_prob": 0.5,
  "max_state_len": 256,
  "max_option_len": 64,
  "grad_clip": 1.0,
  "eval_every_steps": 40,
  "early_stop_patience": 6,
  "dev_selection": true,
  "save_hf_each_epoch": false
}
